msgstr "Có thể"

#: poll/poll.py:894
msgid "Answer choices for this Survey"
msgstr "Các lựa chọn trả lời cho Khảo sát này"

#: poll/poll.py:898
msgid "Are you enjoying the course?"
msgstr "Bạn có thích khóa học này không?"

#: poll/poll.py:900
msgid "Would you recommend this course to your friends?"
msgstr "Bạn có muốn giới thiệu khóa học này cho bạn bè không?"

#: poll/poll.py:904
msgid "Do you think you will learn a lot?"
msgstr "Bạn có nghĩ mình sẽ học được nhiều không?"

