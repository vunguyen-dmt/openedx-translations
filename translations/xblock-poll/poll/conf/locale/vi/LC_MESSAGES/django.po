#: poll/poll.py:232
msgid "Whether or not to display results to the user."
msgstr "Có hiển thị kết quả cho người dùng hay không."

#: poll/poll.py:233
msgid "The maximum number of times a user may send a submission."
msgstr "Số lần tối đa người dùng có thể gửi câu trả lời."

#: poll/poll.py:235
msgid "Number of times the user has sent a submission."
msgstr "Số lần người dùng đã gửi câu trả lời."

#: poll/poll.py:237
msgid "Text to display after the user votes."
msgstr "Nội dung hiển thị sau khi người dùng bỏ phiếu."

#. Translators: {field} is either "answers" or "questions".
#: poll/poll.py:298
#, python-brace-format
msgid "'{field}' is not present, or not a JSON array."
msgstr "'{field}' không tồn tại, hoặc không phải là mảng JSON."

#. Translators: {noun} is either "Answer" or "Question". {item} identifies the
#. answer or question.
#: poll/poll.py:310
#, python-brace-format
msgid "{noun} {item} not a javascript object!"
msgstr "{noun} {item} không phải là đối tượng javascript!"

#. Translators: {noun} is either "Answer" or "Question". {item} identifies the
#. answer or question.
#: poll/poll.py:319
#, python-brace-format
msgid "{noun} {item} contains no key."
msgstr "{noun} {item} không chứa khóa."

#. Translators: {noun} is either "Answer" or "Question".
#. {noun_lower} is the lowercase version of {noun}.
#: poll/poll.py:331
#, python-brace-format
msgid ""
"{noun} has no text or img. Please make sure all {noun_lower}s have one or "
"the other, or both."
msgstr ""
"{noun} không có nội dung hoặc hình ảnh. Vui lòng đảm bảo tất cả {noun_lower}"
" có ít nhất một trong hai, hoặc cả hai."

#. Translators: {noun} is either "Answer" or "Question".
#. {noun_lower} is the lowercase version of {noun}.
#: poll/poll.py:342
#, python-brace-format
msgid ""
"{noun} was added with no label. All {noun_lower}s must have labels. Please "
"check the form. Check the form and explicitly delete {noun_lower}s if not "
"needed."
msgstr ""
"{noun} được thêm mà không có nhãn. Tất cả {noun_lower} phải có nhãn. Vui "
"lòng kiểm tra biểu mẫu. Kiểm tra biểu mẫu và xóa rõ ràng các {noun_lower} "
"nếu không cần thiết."

#: poll/poll.py:350
msgid ""
"All images must have an alternative text describing the image in a way that "
"would allow someone to answer the poll if the image did not load."
msgstr ""
"Tất cả hình ảnh phải có văn bản thay thế mô tả hình ảnh sao cho người dùng "
"có thể trả lời khảo sát ngay cả khi hình ảnh không tải được."

#. Translators: "{noun_lower} is either "answer" or "question".
#: poll/poll.py:362
#, python-brace-format
msgid "You must include at least one {noun_lower}."
msgstr "Bạn phải có ít nhất một {noun_lower}."

#: poll/poll.py:410
msgid "Maximum Submissions missing or not an integer."
msgstr "Số lần gửi tối đa bị thiếu hoặc không phải là số nguyên."

#: poll/poll.py:415
msgid "Private results may not be False when Maximum Submissions is not 1."
msgstr ""
"Kết quả riêng tư không thể là Sai khi Số lần gửi tối đa không phải là 1."

